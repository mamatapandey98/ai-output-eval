# Copy to .env at the project root (gitignored) and fill in locally. Never commit .env.
# Variables already set in the shell take precedence.

# Summary judge, when judge.provider is "gemini" (the default in config/eval.config.json).
# GOOGLE_API_KEY is accepted as an alternative name.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Summary judge, when judge.provider is "anthropic".
# ANTHROPIC_API_KEY=

# DocWeaver login, needed only for live runs (run, screen, cleanup, guarded runners).
# DW_EMAIL=
# DW_PASSWORD=
